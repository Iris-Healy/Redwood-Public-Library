@page
@model IndexModel
@{
    ViewData["Title"] = "Redwood Public Library";
}

<!-- Home page for the Redwood Public Library system with a welcome message, library image, and login button -->
<h1 class="text-center mb-4">Welcome to the Redwood Public Library System</h1>

<div class="text-center">
    <img src="~/images/Redwood_Public_Library.jpg"
         alt="Redwood Public Library"
         class="img-fluid mb-4"
         style="width: 747px; height: auto;" />

    <form method="post">
        <button type="submit" class="btn btn-primary">Login</button>
    </form>
</div>


