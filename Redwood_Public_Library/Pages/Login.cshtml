@page
@model Redwood_Public_Library.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}
<!-- Create Div for Username and Password Content Fields -->
<div class="d-flex justify-content-center align-items-center min-vh-100">
    <form method="post" class="w-100" style="max-width: 400px;">
        <h1 class="text-center mb-4">Login</h1>

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <!-- Add Checkbox for Library Staff Login -->
        <div class="mb-3 form-check">
            <input asp-for="IsStaff" class="form-check-input" />
            <label asp-for="IsStaff" class="form-check-label">I am Library Staff</label>
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Log in</button>
        </div>
    </form>
</div>
<!-- Display warning message if there is one -->
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info mt-3 text-center">@Model.Message</div>
}
